# DCTE server environment variables

# Core (required in production)
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000

# Payments
PAYMONGO_SECRET_KEY=

# Admin product image auto-detection (optional)
ANTHROPIC_API_KEY=

# Firebase (customer auth) — overrides the built-in default "dctestore"
FIREBASE_PROJECT_ID=dctestore

# Order email notifications (optional — orders still work if unset)
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USER=youraddress@gmail.com, SMTP_PASS=<16-char Gmail App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ORDER_NOTIFY_TO=
ORDER_NOTIFY_FROM=

# Persistent storage (set on Railway so data/uploads survive deploys)
DATA_PATH=
UPLOADS_PATH=
